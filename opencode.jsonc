{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["openai", "openrouter", "baseten", "sambanova", "deepinfra"],
  "model": "openai/gpt-5.4",
  "small_model": "openai/gpt-5.4",
  "default_agent": "workflow",
  "instructions": ["AGENTS.md"],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.4": {
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          }
        }
      }
    },
    "openrouter": {
      "models": {
        "google/gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro Preview"
        }
      }
    },
    "baseten": {
      "options": {
        "baseURL": "https://inference.baseten.co/v1"
      },
      "models": {
        "minimax-m2.5": {
          "id": "MiniMaxAI/MiniMax-M2.5",
          "name": "MiniMax M2.5"
        }
      }
    },
    "sambanova": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SambaNova",
      "options": {
        "baseURL": "https://api.sambanova.ai/v1"
      },
      "models": {
        "deepseek-v3.1": {
          "id": "DeepSeek-V3.1",
          "name": "DeepSeek V3.1"
        },
        "minimax-m2.5": {
          "id": "MiniMax-M2.5",
          "name": "MiniMax M2.5"
        }
      }
    },
    "deepinfra": {
      "options": {
        "setCacheKey": true
      },
      "models": {
        "minimax-m2.5": {
          "id": "MiniMaxAI/MiniMax-M2.5",
          "name": "MiniMax M2.5"
        }
      }
    }
  }
}
